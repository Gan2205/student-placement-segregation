# ==============================================================================
# Student Placement Segregation - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values according to your local environment.

# Server Configuration
PROJECT_NAME="Student Placement Segregation System"
ENVIRONMENT="development"
PORT=8000
HOST="127.0.0.1"
DEBUG=True

# Database Configuration (Defaults to local SQLite file)
DATABASE_URL="sqlite:///./database.db"

# Security & CORS
SECRET_KEY="super-secret-placement-system-encryption-key-change-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Placement Segregation Thresholds
TIER_1_MIN_CGPA=8.5
TIER_1_MAX_BACKLOGS=0

TIER_2_MIN_CGPA=7.0
TIER_2_MAX_BACKLOGS=1

TIER_3_MIN_CGPA=6.0
TIER_3_MAX_BACKLOGS=2
