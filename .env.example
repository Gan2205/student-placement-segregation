# ==============================================================================
# Student Placement Segregation System - Root Environment Guide
# ==============================================================================
# This project follows a systematic 3-tier architecture with separate environment
# variable isolation for backend and frontend.

# ------------------------------------------------------------------------------
# 1. Backend Environment Configuration (backend/.env)
# ------------------------------------------------------------------------------
# PROJECT_NAME="Student Placement Segregation System"
# ENVIRONMENT="development"
# PORT=8000
# HOST="127.0.0.1"
# DEBUG=True
# DATABASE_URL="sqlite:///./database.db"
# SECRET_KEY="your-production-secret-key-here"
# ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
#
# Placement Segregation Thresholds:
# TIER_1_MIN_CGPA=8.5
# TIER_1_MAX_BACKLOGS=0
# TIER_2_MIN_CGPA=7.0
# TIER_2_MAX_BACKLOGS=1
# TIER_3_MIN_CGPA=6.0
# TIER_3_MAX_BACKLOGS=2

# ------------------------------------------------------------------------------
# 2. Frontend Environment Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL="http://127.0.0.1:8000/api"
# VITE_APP_TITLE="PlacementSegregator Pro"
# VITE_INSTITUTION_NAME="Campus Career & Placement Cell"
